{
  "extends": "@cardsgame/base-configs/tsconfig.json",
  "exclude": ["testSetup.ts", "**/*.test.*", "**/__*__/**/*"],
  "compilerOptions": {
    "experimentalDecorators": true,
    "outDir": "./dist",
    "paths": {
      "@/actions/*": ["./src/actions/*"],
      "@/annotations/*": ["./src/annotations/*"],
      "@/bots/*": ["./src/bots/*"],
      "@/commands/*": ["./src/commands/*"],
      "@/commandsManager/*": ["./src/commandsManager/*"],
      "@/conditions/*": ["./src/conditions/*"],
      "@/entities/*": ["./src/entities/*"],
      "@/interaction/*": ["./src/interaction/*"],
      "@/messages/*": ["./src/messages/*"],
      "@/player/*": ["./src/player/*"],
      "@/queries/*": ["./src/queries/*"],
      "@/room/*": ["./src/room/*"],
      "@/state/*": ["./src/state/*"],
      "@/traits/*": ["./src/traits/*"],
      "@/utils/*": ["./src/utils/*"],
      "__test__/*": ["./src/__test__/*"]
    }
  }
}
