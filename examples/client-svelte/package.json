{
  "name": "@cardsgame/example-client-svelte",
  "version": "1.7.2",
  "private": true,
  "description": "Svelte client-side implementation example of @cardsgame",
  "author": "Darek Greenly (https://darekgreenly.com)",
  "license": "MIT",
  "type": "module",
  "main": "index.html",
  "scripts": {
    "start": "npm run build && sirv dist --http2 --key ../../node_modules/@cardsgame/example-certs/localhost.key --cert ../../node_modules/@cardsgame/example-certs/localhost.crt",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "@cardsgame/client": "^1.7.2",
    "@cardsgame/example-certs": "^1.6.0",
    "@colyseus/schema": "^1.0.46"
  },
  "devDependencies": {
    "@cardsgame/example-types": "^1.7.1",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tsconfig/svelte": "^5.0.8",
    "svelte": "^5.53.12",
    "svelte-check": "^4.4.5",
    "typescript": "~5.9.3",
    "vite": "^8.0.1"
  }
}
